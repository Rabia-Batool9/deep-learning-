,"execution":{"iopub.status.busy":"2026-07-15T03:47:54.735064Z","iopub.execute_input":"2026-07-15T03:47:54.735548Z","iopub.status.idle":"2026-07-15T03:47:54.742558Z","shell.execute_reply.started":"2026-07-15T03:47:54.735518Z","shell.execute_reply":"2026-07-15T03:47:54.741626Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. Load the Dataset (robust ImageFolder-style loader)\n\nThis treats every direct subfolder of `DATA_DIR` as its own class (the standard\n\"ImageFolder\" layout), then keeps only folders that look like cat/dog. This works\nregardless of exact casing or naming (`Cat`/`Dog`, `cats`/`dogs`, etc.).\n","metadata":{}},{"cell_type":"code","source":"DATA_DIR = \"/kaggle/input/datasets/anthonytherrien/dog-vs-cat/animals\"\n\nassert os.path.exists(DATA_DIR), f\"Path not found: {DATA_DIR}\"\nprint(\"Top-level contents:\", os.listdir(DATA_DIR))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:47:59.450539Z","iopub.execute_input":"2026-07-15T03:47:59.451327Z","iopub.status.idle":"2026-07-15T03:47:59.474083Z","shell.execute_reply.started":"2026-07-15T03:47:59.451297Z","shell.execute_reply":"2026-07-15T03:47:59.473419Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def build_dataframe(data_dir):\n    records = []\n    class_dirs = [d for d in os.listdir(data_dir) if os.path.isdir(os.path.join(data_dir, d))]\n    print(\"Detected class folders:\", class_dirs)\n\n    for class_dir in class_dirs:\n        lower = class_dir.lower()\n        if \"cat\" in lower:\n            label = \"cat\"\n        elif \"dog\" in lower:\n            label = \"dog\"\n        else:\n            # skip folders that aren't cat/dog (e.g. other animal classes)\n            print(f\"Skipping non cat/dog folder: {class_dir}\")\n            continue\n\n        class_path = os.path.join(data_dir, class_dir)\n        for root, _, files in os.walk(class_path):\n            for f in files:\n                if f.lower().endswith((\".jpg\", \".jpeg\", \".png\")):\n                    records.append({\"filepath\": os.path.join(root, f), \"label\": label})\n\n    return pd.DataFrame(records)\n\ndf = build_dataframe(DATA_DIR)\nprint(df.shape)\nprint(df[\"label\"].value_counts())\ndf.head()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:48:03.446161Z","iopub.execute_input":"2026-07-15T03:48:03.446803Z","iopub.status.idle":"2026-07-15T03:48:03.970235Z","shell.execute_reply.started":"2026-07-15T03:48:03.446774Z","shell.execute_reply":"2026-07-15T03:48:03.969606Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"assert len(df) > 0, \"No cat/dog images found — check the folder names printed above and adjust build_dataframe.\"\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:48:11.566078Z","iopub.execute_input":"2026-07-15T03:48:11.566357Z","iopub.status.idle":"2026-07-15T03:48:11.570456Z","shell.execute_reply.started":"2026-07-15T03:48:11.566336Z","shell.execute_reply":"2026-07-15T03:48:11.569648Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Exploratory Data Analysis (EDA)","metadata":{}},{"cell_type":"code","source":"# Class balance\ncounts = df[\"label\"].value_counts()\nprint(counts)\n\nplt.figure(figsize=(5,4))\nsns.barplot(x=counts.index, y=counts.values, palette=\"Set2\")\nplt.title(\"Class Distribution\")\nplt.ylabel(\"Number of images\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:48:09.16675Z","iopub.execute_input":"2026-07-15T03:48:09.16719Z","iopub.status.idle":"2026-07-15T03:48:09.351016Z","shell.execute_reply.started":"2026-07-15T03:48:09.167162Z","shell.execute_reply":"2026-07-15T03:48:09.350378Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Sample images grid\ndef show_samples(df, n=9):\n    sample = df.sample(n, random_state=SEED)\n    plt.figure(figsize=(9,9))\n    for i, (_, row) in enumerate(sample.iterrows()):\n        img = keras.utils.load_img(row[\"filepath\"])\n        plt.subplot(3, 3, i+1)\n        plt.imshow(img)\n        plt.title(row[\"label\"])\n        plt.axis(\"off\")\n    plt.tight_layout()\n    plt.show()\n\nshow_samples(df)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:48:18.599603Z","iopub.execute_input":"2026-07-15T03:48:18.600192Z","iopub.status.idle":"2026-07-15T03:48:19.714914Z","shell.execute_reply.started":"2026-07-15T03:48:18.600164Z","shell.execute_reply":"2026-07-15T03:48:19.71395Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Image size / aspect ratio distribution (helps decide target input size)\nsizes = []\nfor fp in df[\"filepath\"].sample(min(500, len(df)), random_state=SEED):\n    with keras.utils.load_img(fp) as img:\n        sizes.append(img.size)  # (width, height)\n\nsizes = np.array(sizes)\nprint(\"Width  - min/mean/max:\", sizes[:,0].min(), sizes[:,0].mean(), sizes[:,0].max())\nprint(\"Height - min/mean/max:\", sizes[:,1].min(), sizes[:,1].mean(), sizes[:,1].max())\n\nplt.figure(figsize=(5,5))\nplt.scatter(sizes[:,0], sizes[:,1], alpha=0.3)\nplt.xlabel(\"Width\"); plt.ylabel(\"Height\")\nplt.title(\"Sampled image dimensions\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:48:36.405644Z","iopub.execute_input":"2026-07-15T03:48:36.405982Z","iopub.status.idle":"2026-07-15T03:48:41.210087Z","shell.execute_reply.started":"2026-07-15T03:48:36.405953Z","shell.execute_reply":"2026-07-15T03:48:41.20938Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 4. Train / Validation / Test Split","metadata":{}},{"cell_type":"code","source":"IMG_SIZE = (160, 160)\nBATCH_SIZE = 32\n\ntrain_df, temp_df = train_test_split(df, test_size=0.3, stratify=df[\"label\"], random_state=SEED)\nval_df, test_df = train_test_split(temp_df, test_size=0.5, stratify=temp_df[\"label\"], random_state=SEED)\n\nprint(\"Train:\", len(train_df), \"Val:\", len(val_df), \"Test:\", len(test_df))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:48:48.741373Z","iopub.execute_input":"2026-07-15T03:48:48.742046Z","iopub.status.idle":"2026-07-15T03:48:48.754536Z","shell.execute_reply.started":"2026-07-15T03:48:48.742016Z","shell.execute_reply":"2026-07-15T03:48:48.753546Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 5. Data Pipelines (with Augmentation)\n\nWe build `tf.data` pipelines from the dataframes for efficient loading, and apply\naugmentation (flip, rotation, zoom, contrast) only to the training set.\n","metadata":{}},{"cell_type":"code","source":"def make_dataset(dataframe, img_size, batch_size, training=False):\n    label_map = {\"cat\": 0, \"dog\": 1}\n    filepaths = dataframe[\"filepath\"].values\n    labels = dataframe[\"label\"].map(label_map).values\n\n    ds = tf.data.Dataset.from_tensor_slices((filepaths, labels))\n\n    def load_img(path, label):\n        img = tf.io.read_file(path)\n        img = tf.image.decode_jpeg(img, channels=3)\n        img = tf.image.resize(img, img_size)\n        return img, label\n\n    ds = ds.map(load_img, num_parallel_calls=tf.data.AUTOTUNE)\n\n    if training:\n        ds = ds.shuffle(1000, seed=SEED)\n\n    ds = ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)\n    return ds\n\ntrain_ds = make_dataset(train_df, IMG_SIZE, BATCH_SIZE, training=True)\nval_ds   = make_dataset(val_df,   IMG_SIZE, BATCH_SIZE)\ntest_ds  = make_dataset(test_df,  IMG_SIZE, BATCH_SIZE)\n\ndata_augmentation = keras.Sequential([\n    layers.RandomFlip(\"horizontal\"),\n    layers.RandomRotation(0.1),\n    layers.RandomZoom(0.1),\n    layers.RandomContrast(0.1),\n], name=\"augmentation\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:48:53.805955Z","iopub.execute_input":"2026-07-15T03:48:53.806576Z","iopub.status.idle":"2026-07-15T03:48:55.696861Z","shell.execute_reply.started":"2026-07-15T03:48:53.806547Z","shell.execute_reply":"2026-07-15T03:48:55.696245Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Visualize what augmentation does to a sample image\nsample_img_path = train_df[\"filepath\"].iloc[0]\nimg = keras.utils.load_img(sample_img_path, target_size=IMG_SIZE)\nimg_arr = keras.utils.img_to_array(img)\nimg_batch = tf.expand_dims(img_arr, 0)\n\nplt.figure(figsize=(9,9))\nfor i in range(9):\n    augmented = data_augmentation(img_batch, training=True)\n    plt.subplot(3,3,i+1)\n    plt.imshow(augmented[0].numpy().astype(\"uint8\"))\n    plt.axis(\"off\")\nplt.suptitle(\"Augmentation examples on one image\")\nplt.tight_layout()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:49:02.669762Z","iopub.execute_input":"2026-07-15T03:49:02.670608Z","iopub.status.idle":"2026-07-15T03:49:06.109214Z","shell.execute_reply.started":"2026-07-15T03:49:02.670578Z","shell.execute_reply":"2026-07-15T03:49:06.108041Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 6. Model 1 — Baseline CNN (from scratch)\n\nA simple convolutional network trained end-to-end, to establish a baseline before\nusing transfer learning.\n","metadata":{}},{"cell_type":"code","source":"def build_baseline_cnn(input_shape):\n    inputs = keras.Input(shape=input_shape)\n    x = layers.Rescaling(1./255)(inputs)\n    x = data_augmentation(x)\n\n    for filters in [32, 64, 128, 128]:\n        x = layers.Conv2D(filters, 3, padding=\"same\", activation=\"relu\")(x)\n        x = layers.BatchNormalization()(x)\n        x = layers.MaxPooling2D()(x)\n\n    x = layers.GlobalAveragePooling2D()(x)\n    x = layers.Dropout(0.4)(x)\n    x = layers.Dense(64, activation=\"relu\")(x)\n    outputs = layers.Dense(1, activation=\"sigmoid\")(x)\n\n    return keras.Model(inputs, outputs, name=\"baseline_cnn\")\n\nbaseline_model = build_baseline_cnn(IMG_SIZE + (3,))\nbaseline_model.compile(\n    optimizer=keras.optimizers.Adam(1e-3),\n    loss=\"binary_crossentropy\",\n    metrics=[\"accuracy\"]\n)\nbaseline_model.summary()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:49:17.029699Z","iopub.execute_input":"2026-07-15T03:49:17.030538Z","iopub.status.idle":"2026-07-15T03:49:17.153759Z","shell.execute_reply.started":"2026-07-15T03:49:17.030505Z","shell.execute_reply":"2026-07-15T03:49:17.153014Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"early_stop = keras.callbacks.EarlyStopping(patience=4, restore_best_weights=True, monitor=\"val_loss\")\nreduce_lr = keras.callbacks.ReduceLROnPlateau(patience=2, factor=0.5, monitor=\"val_loss\")\n\nEPOCHS = 15\n\nhistory_baseline = baseline_model.fit(\n    train_ds,\n    validation_data=val_ds,\n    epochs=EPOCHS,\n    callbacks=[early_stop, reduce_lr]\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:49:22.525339Z","iopub.execute_input":"2026-07-15T03:49:22.52604Z","iopub.status.idle":"2026-07-15T03:49:49.372989Z","shell.execute_reply.started":"2026-07-15T03:49:22.526009Z","shell.execute_reply":"2026-07-15T03:49:49.372292Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def plot_history(history, title):\n    hist = history.history\n    fig, axes = plt.subplots(1, 2, figsize=(11,4))\n    axes[0].plot(hist[\"accuracy\"], label=\"train\")\n    axes[0].plot(hist[\"val_accuracy\"], label=\"val\")\n    axes[0].set_title(f\"{title} — Accuracy\"); axes[0].legend()\n\n    axes[1].plot(hist[\"loss\"], label=\"train\")\n    axes[1].plot(hist[\"val_loss\"], label=\"val\")\n    axes[1].set_title(f\"{title} — Loss\"); axes[1].legend()\n    plt.tight_layout(); plt.show()\n\nplot_history(history_baseline, \"Baseline CNN\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:49:56.590374Z","iopub.execute_input":"2026-07-15T03:49:56.590834Z","iopub.status.idle":"2026-07-15T03:49:56.888492Z","shell.execute_reply.started":"2026-07-15T03:49:56.590805Z","shell.execute_reply":"2026-07-15T03:49:56.887552Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 7. Model 2 — Transfer Learning (MobileNetV2)\n\nWe reuse ImageNet-pretrained features. First we train only the new classification\nhead (base frozen), then fine-tune the top layers of the base model at a low\nlearning rate.\n","metadata":{}},{"cell_type":"code","source":"def make_tl_dataset(dataframe, img_size, batch_size, training=False):\n    label_map = {\"cat\": 0, \"dog\": 1}\n    filepaths = dataframe[\"filepath\"].values\n    labels = dataframe[\"label\"].map(label_map).values\n    ds = tf.data.Dataset.from_tensor_slices((filepaths, labels))\n\n    def load_img(path, label):\n        img = tf.io.read_file(path)\n        img = tf.image.decode_jpeg(img, channels=3)\n        img = tf.image.resize(img, img_size)\n        img = preprocess_input(img)  # MobileNetV2-specific preprocessing\n        return img, label\n\n    ds = ds.map(load_img, num_parallel_calls=tf.data.AUTOTUNE)\n    if training:\n        ds = ds.shuffle(1000, seed=SEED)\n    return ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)\n\ntrain_ds_tl = make_tl_dataset(train_df, IMG_SIZE, BATCH_SIZE, training=True)\nval_ds_tl   = make_tl_dataset(val_df,   IMG_SIZE, BATCH_SIZE)\ntest_ds_tl  = make_tl_dataset(test_df,  IMG_SIZE, BATCH_SIZE)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:50:09.893221Z","iopub.execute_input":"2026-07-15T03:50:09.894088Z","iopub.status.idle":"2026-07-15T03:50:09.98296Z","shell.execute_reply.started":"2026-07-15T03:50:09.894037Z","shell.execute_reply":"2026-07-15T03:50:09.982286Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"base_model = MobileNetV2(input_shape=IMG_SIZE + (3,), include_top=False, weights=\"imagenet\")\nbase_model.trainable = False\n\ninputs = keras.Input(shape=IMG_SIZE + (3,))\nx = data_augmentation(inputs)\nx = base_model(x, training=False)\nx = layers.GlobalAveragePooling2D()(x)\nx = layers.Dropout(0.3)(x)\noutputs = layers.Dense(1, activation=\"sigmoid\")(x)\ntl_model = keras.Model(inputs, outputs, name=\"mobilenetv2_transfer\")\n\ntl_model.compile(optimizer=keras.optimizers.Adam(1e-3),\n                  loss=\"binary_crossentropy\", metrics=[\"accuracy\"])\ntl_model.summary()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:50:21.829152Z","iopub.execute_input":"2026-07-15T03:50:21.829726Z","iopub.status.idle":"2026-07-15T03:50:23.025795Z","shell.execute_reply.started":"2026-07-15T03:50:21.829695Z","shell.execute_reply":"2026-07-15T03:50:23.025175Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"history_tl = tl_model.fit(\n    train_ds_tl,\n    validation_data=val_ds_tl,\n    epochs=10,\n    callbacks=[early_stop, reduce_lr]\n)\nplot_history(history_tl, \"MobileNetV2 (frozen base)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:50:34.94926Z","iopub.execute_input":"2026-07-15T03:50:34.949691Z","iopub.status.idle":"2026-07-15T03:51:16.563186Z","shell.execute_reply.started":"2026-07-15T03:50:34.949663Z","shell.execute_reply":"2026-07-15T03:51:16.562376Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### 7.1 Fine-tuning (unfreeze top layers)","metadata":{}},{"cell_type":"code","source":"base_model.trainable = True\nFINE_TUNE_AT = len(base_model.layers) - 30\nfor layer in base_model.layers[:FINE_TUNE_AT]:\n    layer.trainable = False\n\ntl_model.compile(optimizer=keras.optimizers.Adam(1e-5),\n                  loss=\"binary_crossentropy\", metrics=[\"accuracy\"])\n\nhistory_finetune = tl_model.fit(\n    train_ds_tl,\n    validation_data=val_ds_tl,\n    epochs=8,\n    callbacks=[early_stop, reduce_lr]\n)\nplot_history(history_finetune, \"MobileNetV2 (fine-tuned)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:51:16.564708Z","iopub.execute_input":"2026-07-15T03:51:16.565135Z","iopub.status.idle":"2026-07-15T03:51:57.586624Z","shell.execute_reply.started":"2026-07-15T03:51:16.565103Z","shell.execute_reply":"2026-07-15T03:51:57.585801Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 8. Evaluation on the Held-out Test Set","metadata":{}},{"cell_type":"code","source":"def evaluate_model(model, ds, dataframe, name):\n    loss, acc = model.evaluate(ds)\n    print(f\"{name} — Test loss: {loss:.4f}, Test accuracy: {acc:.4f}\")\n\n    y_true = dataframe[\"label\"].map({\"cat\":0, \"dog\":1}).values\n    y_prob = model.predict(ds).ravel()\n    y_pred = (y_prob > 0.5).astype(int)\n\n    cm_ = confusion_matrix(y_true, y_pred)\n    disp = ConfusionMatrixDisplay(cm_, display_labels=[\"cat\",\"dog\"])\n    disp.plot(cmap=\"Blues\")\n    plt.title(f\"{name} — Confusion Matrix\")\n    plt.show()\n\n    print(classification_report(y_true, y_pred, target_names=[\"cat\",\"dog\"]))\n\n    fpr, tpr, _ = roc_curve(y_true, y_prob)\n    roc_auc = auc(fpr, tpr)\n    plt.figure(figsize=(5,5))\n    plt.plot(fpr, tpr, label=f\"AUC = {roc_auc:.3f}\")\n    plt.plot([0,1],[0,1],\"--\", color=\"gray\")\n    plt.xlabel(\"False Positive Rate\"); plt.ylabel(\"True Positive Rate\")\n    plt.title(f\"{name} — ROC Curve\"); plt.legend()\n    plt.show()\n\n    return y_true, y_pred, y_prob\n\nprint(\"=== Baseline CNN ===\")\nyt_b, yp_b, ypr_b = evaluate_model(baseline_model, test_ds, test_df, \"Baseline CNN\")\n\nprint(\"=== MobileNetV2 (fine-tuned) ===\")\nyt_tl, yp_tl, ypr_tl = evaluate_model(tl_model, test_ds_tl, test_df, \"MobileNetV2\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:51:57.590644Z","iopub.execute_input":"2026-07-15T03:51:57.591019Z","iopub.status.idle":"2026-07-15T03:52:02.611816Z","shell.execute_reply.started":"2026-07-15T03:51:57.590994Z","shell.execute_reply":"2026-07-15T03:52:02.61095Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 9. Error Analysis — Misclassified Images","metadata":{}},{"cell_type":"code","source":"def show_misclassified(dataframe, y_true, y_pred, n=9):\n    dataframe = dataframe.reset_index(drop=True).copy()\n    dataframe[\"y_true\"] = y_true\n    dataframe[\"y_pred\"] = y_pred\n    wrong = dataframe[dataframe[\"y_true\"] != dataframe[\"y_pred\"]]\n    print(f\"{len(wrong)} misclassified out of {len(dataframe)}\")\n\n    if len(wrong) == 0:\n        return\n    sample = wrong.sample(min(n, len(wrong)), random_state=SEED)\n    label_map = {0: \"cat\", 1: \"dog\"}\n    plt.figure(figsize=(9,9))\n    for i, (_, row) in enumerate(sample.iterrows()):\n        img = keras.utils.load_img(row[\"filepath\"])\n        plt.subplot(3,3,i+1)\n        plt.imshow(img)\n        plt.title(f\"true={label_map[row['y_true']]}, pred={label_map[row['y_pred']]}\")\n        plt.axis(\"off\")\n    plt.tight_layout(); plt.show()\n\nshow_misclassified(test_df, yt_tl, yp_tl)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:52:02.612987Z","iopub.execute_input":"2026-07-15T03:52:02.613623Z","iopub.status.idle":"2026-07-15T03:52:02.745277Z","shell.execute_reply.started":"2026-07-15T03:52:02.613555Z","shell.execute_reply":"2026-07-15T03:52:02.744389Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 10. Model Interpretability — Grad-CAM\n\nVisualize which regions of an image the fine-tuned model focuses on when making\nits prediction.\n","metadata":{}},{"cell_type":"code","source":"def show_gradcam(filepath, model, base_model, img_size=IMG_SIZE):\n    img = keras.utils.load_img(filepath, target_size=img_size)\n    arr = keras.utils.img_to_array(img)\n    arr_batch = preprocess_input(np.expand_dims(arr, axis=0))\n\n    last_conv_name = [l.name for l in base_model.layers if isinstance(l, layers.Conv2D)][-1]\n    conv_layer_model = keras.Model(base_model.input, base_model.get_layer(last_conv_name).output)\n\n    with tf.GradientTape() as tape:\n        conv_out = conv_layer_model(arr_batch)\n        tape.watch(conv_out)\n        x = layers.GlobalAveragePooling2D()(conv_out)\n        preds = model.layers[-1](model.layers[-2](x))  # dropout -> dense\n        class_channel = preds[:, 0]\n\n    grads = tape.gradient(class_channel, conv_out)\n    pooled_grads = tf.reduce_mean(grads, axis=(0,1,2))\n    heatmap = tf.reduce_sum(conv_out[0] * pooled_grads, axis=-1)\n    heatmap = tf.maximum(heatmap, 0) / (tf.math.reduce_max(heatmap) + 1e-8)\n    heatmap = heatmap.numpy()\n\n    heatmap_resized = tf.image.resize(heatmap[..., np.newaxis], img_size).numpy().squeeze()\n    jet = cm.get_cmap(\"jet\")(heatmap_resized)[..., :3]\n\n    overlay = jet * 0.4 + arr / 255.0\n    overlay = np.clip(overlay, 0, 1)\n\n    fig, axes = plt.subplots(1, 2, figsize=(8,4))\n    axes[0].imshow(arr.astype(\"uint8\")); axes[0].set_title(\"Original\"); axes[0].axis(\"off\")\n    axes[1].imshow(overlay); axes[1].set_title(\"Grad-CAM\"); axes[1].axis(\"off\")\n    plt.tight_layout(); plt.show()\n\nsample_path = test_df.sample(1, random_state=SEED)[\"filepath\"].values[0]\nshow_gradcam(sample_path, tl_model, base_model)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:52:23.153723Z","iopub.execute_input":"2026-07-15T03:52:23.154265Z","iopub.status.idle":"2026-07-15T03:52:23.727879Z","shell.execute_reply.started":"2026-07-15T03:52:23.154236Z","shell.execute_reply":"2026-07-15T03:52:23.727237Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 11. Inference on a New Image","metadata":{}},{"cell_type":"code","source":"def predict_image(filepath, model, img_size=IMG_SIZE, preprocess=preprocess_input):\n    img = keras.utils.load_img(filepath, target_size=img_size)\n    arr = keras.utils.img_to_array(img)\n    arr = preprocess(arr)\n    arr = np.expand_dims(arr, axis=0)\n    prob = model.predict(arr)[0][0]\n    label = \"dog\" if prob > 0.5 else \"cat\"\n    confidence = prob if prob > 0.5 else 1 - prob\n    plt.imshow(img)\n    plt.title(f\"Prediction: {label} ({confidence:.2%} confidence)\")\n    plt.axis(\"off\")\n    plt.show()\n    return label, confidence\n\n# Example — try it on a random test image:\nexample_path = test_df.sample(1, random_state=1)[\"filepath\"].values[0]\npredict_image(example_path, tl_model)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:52:32.633324Z","iopub.execute_input":"2026-07-15T03:52:32.633607Z","iopub.status.idle":"2026-07-15T03:52:34.217664Z","shell.execute_reply.started":"2026-07-15T03:52:32.633576Z","shell.execute_reply":"2026-07-15T03:52:34.216975Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 12. Save the Final Model","metadata":{}},{"cell_type":"code","source":"tl_model.save(\"dog_vs_cat_mobilenetv2.keras\")\nprint(\"Model saved.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T03:52:43.545279Z","iopub.execute_input":"2026-07-15T03:52:43.54556Z","iopub.status.idle":"2026-07-15T03:52:44.093862Z","shell.execute_reply.started":"2026-07-15T03:52:43.545539Z","shell.execute_reply":"2026-07-15T03:52:44.092964Z"}},"outputs":[],"execution_count":null}]}