d features."]},{"cell_type":"code","execution_count":15,"id":"0b77cb29","metadata":{"execution":{"iopub.execute_input":"2026-08-23T17:38:10.180116Z","iopub.status.busy":"2026-08-23T17:38:10.179832Z","iopub.status.idle":"2026-08-23T17:38:37.376398Z","shell.execute_reply":"2026-08-23T17:38:37.375698Z"},"papermill":{"duration":27.313059,"end_time":"2026-08-23T17:38:37.378009+00:00","exception":false,"start_time":"2026-08-23T17:38:10.06495+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Extracting training features...\n","\u001b[1m90/90\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m21s\u001b[0m 186ms/step\n","Extracting test features...\n","\u001b[1m13/13\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m6s\u001b[0m 468ms/step\n","Feature shapes: (2870, 2048) (394, 2048)\n"]}],"source":["# Build a feature-extractor model that outputs the GlobalAveragePooling layer\n","feature_extractor = Model(inputs=transfer_model.input,\n","                           outputs=transfer_model.get_layer('feature_vector').output)\n","\n","def extract_features(generator):\n","    generator.reset()\n","    features = feature_extractor.predict(generator, verbose=1)\n","    labels = generator.classes[:len(features)]\n","    return features, labels\n","\n","print('Extracting training features...')\n","X_train_feat, y_train_feat = extract_features(transfer_feat_train_gen)\n","\n","print('Extracting test features...')\n","X_test_feat, y_test_feat = extract_features(transfer_test_gen)\n","\n","print('Feature shapes:', X_train_feat.shape, X_test_feat.shape)\n","\n"]},{"cell_type":"code","execution_count":16,"id":"d98d1297","metadata":{"execution":{"iopub.execute_input":"2026-08-23T17:38:37.605014Z","iopub.status.busy":"2026-08-23T17:38:37.604191Z","iopub.status.idle":"2026-08-23T17:39:17.619908Z","shell.execute_reply":"2026-08-23T17:39:17.616185Z"},"papermill":{"duration":40.130062,"end_tim