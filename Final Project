tputs=outputs, name=f'transfer_{backbone}')\n","\n","transfer_model = build_transfer_model()\n","transfer_model.compile(optimizer=Adam(1e-4), loss='categorical_crossentropy', metrics=['accuracy'])\n","transfer_model.summary()\n","\n"]},{"cell_type":"code","execution_count":14,"id":"3bfc93f4","metadata":{"execution":{"iopub.execute_input":"2026-08-23T17:31:54.090361Z","iopub.status.busy":"2026-08-23T17:31:54.089963Z","iopub.status.idle":"2026-08-23T17:38:09.721019Z","shell.execute_reply":"2026-08-23T17:38:09.720355Z"},"papermill":{"duration":375.718445,"end_time":"2026-08-23T17:38:09.722551+00:00","exception":false,"start_time":"2026-08-23T17:31:54.004106+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Epoch 1/20\n","\u001b[1m77/77\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m67s\u001b[0m 645ms/step - accuracy: 0.7411 - loss: 0.6744 - val_accuracy: 0.7692 - val_loss: 0.5852\n","Epoch 2/20\n","\u001b[1m77/77\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m37s\u001b[0m 476ms/step - accuracy: 0.8853 - loss: 0.3031 - val_accuracy: 0.8392 - val_loss: 0.4232\n","Epoch 3/20\n","\u001b[1m77/77\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m36s\u001b[0m 469ms/step - accuracy: 0.9197 - loss: 0.2212 - val_accuracy: 0.8485 - val_loss: 0.4595\n","Epoch 4/20\n","\u001b[1m77/77\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m37s\u001b[0m 482ms/step - accuracy: 0.9476 - loss: 0.1540 - val_accuracy: 0.8648 - val_loss: 0.4649\n","Epoch 5/20\n","\u001b[1m77/77\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m42s\u001b[0m 544ms/step - accuracy: 0.9521 - loss: 0.1342 - val_accuracy: 0.9161 - val_loss: 0.2993\n","Epoch 6/20\n","\u001b[1m77/77\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m41s\u001b[0m 531ms/step - accuracy: 0.9648 - loss: 0.1007 - val_accuracy: 0